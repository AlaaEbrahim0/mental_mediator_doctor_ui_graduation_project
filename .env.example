# Mental Mediator doctor portal — environment template
#
# Copy this file to `.env` and adjust the values. `.env` is gitignored and
# must never be committed. `.env.development.local` (also gitignored) is the
# right place for machine-specific values.
#
# Every variable must start with REACT_APP_ to be readable by the client build.

# Backend API base URL. No trailing slash needed; it is normalized in
# src/api/client.js.
REACT_APP_API_URL=https://nexus-api.runasp.net/

# Path to static images bundled with the app.
REACT_APP_IMAGE_BASE_URL=/images
